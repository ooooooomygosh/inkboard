{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true, "noImplicitAny": false,
    "jsx": "react-jsx", "jsxImportSource": "preact", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["@cloudflare/workers-types"], "skipLibCheck": true, "noEmit": true, "isolatedModules": true
  },
  "include": ["src", "shared", "web/src"]
}
