{
  "name": "inkboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "node web/build.mjs",
    "dev": "node web/build.mjs && wrangler dev --ip 0.0.0.0 --port 8787 --test-scheduled",
    "db:init": "wrangler d1 execute inkboard --local --file=schema.sql",
    "db:init:remote": "wrangler d1 execute inkboard --remote --file=schema.sql",
    "deploy": "node web/build.mjs && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "preact": "^10.29.8",
    "qrcode-generator": "^1.5.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.159.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261109.1": true
  }
}
